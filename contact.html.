<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contact - Amina Otieno</title>
</head>
<body>
  <header>
    <a href="index.html">Amina Otieno</a>
    <nav aria-label="Main">
      <ul>
        <li><a href="index.html">Home</a></li>
        <li><a href="about.html">About</a></li>
        <li><a href="projects.html">Projects</a></li>
        <li><a href="contact.html" aria-current="page">Contact</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <h1>Contact me</h1>

    <form action="#" method="post">
      <fieldset>
        <legend>About you</legend>
        
        <label for="name">Full name</label>
        <input type="text" id="name" name="name" placeholder="e.g. Amina Otieno" required>

        <label for="email">Email</label>
        <input type="email" id="email" name="email" placeholder="name@gmail.com" required>

        <label for="phone">Phone (optional)</label>
        <input type="tel" id="phone" name="phone" placeholder="0712 345 678">
      </fieldset>

      <fieldset>
        <legend>Your message</legend>

        <label for="subject">Subject</label>
        <select id="subject" name="subject" required>
          <option value="">Choose a subject</option>
          <option value="project">A project idea</option>
          <option value="mentoring">Mentoring</option>
          <option value="other">Something else</option>
        </select>

        <label for="message">Message (at least 50 characters)</label>
        <textarea id="message" name="message" rows="6" minlength="50" required placeholder="Tell me what you'd like to talk about"></textarea>

        <input type="checkbox" id="newsletter" name="newsletter">
        <label for="newsletter">Send me occasional updates</label>
      </fieldset>

      <button type="submit">Send message</button>
    </form>
  </main>

  <footer>
    <address>
      Nairobi, Kenya (EAT, UTC+3) · 
      <a href="mailto:amina.otieno.dev@gmail.com">amina.otieno.dev@gmail.com</a>
    </address>
    <p><small>© 2026 Amina Otieno</small></p>
  </footer>
</body>
</html>
